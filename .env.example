DISCORD_TOKEN=
CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_SECRET=
GUILD_ID=
DATABASE_URL=
DASHBOARD_URL=http://localhost:5173
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
PORT=3000

# Optional — enables the TikTok source for "إشعارات المقاطع" (creator announcements).
# YouTube works without any key. Leave blank to keep TikTok disabled.
RAPIDAPI_KEY=
RAPIDAPI_TIKTOK_HOST=tiktok-scraper7.p.rapidapi.com

# Optional — external Lavalink node for the music feature (run on a VPS, see lavalink/README.md).
# Leave blank to keep music disabled (the bot boots fine without it).
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false

# Optional — Anthropic API key enabling AI ticket summaries (on close). Leave blank to keep AI off.
ANTHROPIC_API_KEY=

# Optional — your Discord user ID; unlocks the owner-only bot page (/api/bot). Unset = owner page disabled (fail closed).
OWNER_DISCORD_ID=
