generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GuildSettings {
  guildId        String         @id
  language       String         @default("ar")
  logChannelId   String?
  staffRoleIds   String[]       @default([])
  // Welcome / goodbye (1:1, folded in to avoid an extra join)
  welcomeEnabled Boolean        @default(false)
  welcomeChannelId String?
  welcomeMessage String?
  goodbyeEnabled Boolean        @default(false)
  goodbyeMessage String?
  autoRoleId     String?
  // Bot presence (dashboard-configurable). Null type = default Watching <count> عضو • /help.
  botPresenceType String?       // playing | listening | watching | streaming | custom
  botPresenceText String?
  botPresenceUrl  String?       // twitch/youtube URL, only for streaming
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  autoMod        AutoModConfig?
}

model AutoModConfig {
  guildId           String        @id
  enabled           Boolean       @default(false)
  antiSpam          Boolean       @default(false)
  antiInvite        Boolean       @default(false)
  antiLink          Boolean       @default(false)
  bannedWords       String[]      @default([])
  maxMentions       Int           @default(5)
  actionOnViolation String        @default("delete") // delete | warn | mute | kick | ban
  muteSeconds       Int           @default(300)
  ignoredChannelIds String[]      @default([])
  ignoredRoleIds    String[]      @default([])
  settings          GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ModerationCase {
  id           String    @id @default(cuid())
  guildId      String
  targetUserId String
  moderatorId  String
  type         String
  reason       String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  active       Boolean   @default(true)

  @@index([guildId, targetUserId])
  @@index([guildId, active, expiresAt])
  @@index([guildId, createdAt])
}

model LogEntry {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId, type, createdAt])
  @@index([guildId, createdAt])
}

// One row per guild per UTC day, upserted by the in-memory stat aggregator that
// the scheduler flushes. Powers the analytics charts without writing a row per event.
model DailyStat {
  id          String   @id @default(cuid())
  guildId     String
  date        String // YYYY-MM-DD (UTC)
  messages    Int      @default(0)
  joins       Int      @default(0)
  leaves      Int      @default(0)
  modActions  Int      @default(0)
  memberCount Int      @default(0)

  @@unique([guildId, date])
  @@index([guildId, date])
}

// ---- Leveling / XP ----
model LevelConfig {
  guildId         String  @id
  enabled         Boolean @default(false)
  xpPerMessage    Int     @default(18)
  cooldownSeconds Int     @default(60)
  multiplier      Int     @default(1)
  levelUpEnabled  Boolean @default(true)
  levelUpChannelId String?
  levelUpMessage  String? // {user} {level}
  stackRewards    Boolean @default(false)
}

model LevelRoleReward {
  id      String @id @default(cuid())
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
  @@index([guildId])
}

model MemberLevel {
  guildId       String
  userId        String
  xp            Int      @default(0)
  level         Int      @default(0)
  lastMessageAt DateTime @default(now())

  @@id([guildId, userId])
  @@index([guildId, xp])
}

// ---- Button role panels ----
model RolePanel {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String?
  messageId   String?
  title       String
  description String?
  roles       Json     @default("[]") // [{ roleId, label, emoji?, style? }]
  createdAt   DateTime @default(now())

  @@index([guildId])
}

// ---- Auto-responder ----
model AutoResponse {
  id        String  @id @default(cuid())
  guildId   String
  trigger   String
  matchType String  @default("contains") // contains | exact | startswith
  reply     String
  enabled   Boolean @default(true)

  @@index([guildId])
}

// ---- Scheduled messages ----
model ScheduledMessage {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  content   String
  runAt     DateTime
  repeat    String   @default("none") // none | daily | weekly
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([enabled, runAt])
}

// ---- Tickets ----
model TicketConfig {
  guildId             String  @id
  enabled             Boolean @default(false)
  categoryId          String? // fallback "default type" when no TicketType rows exist
  supportRoleId       String?
  openMessage         String?
  counter             Int     @default(0)
  transcriptChannelId String? // where transcripts are posted; falls back to logChannelId
  dmOnOpen            Boolean @default(true)
  dmOnClose           Boolean @default(true)
}

// One configurable kind of ticket (Support / Report / Partnership...). When none exist the
// panel shows a single button and opens use TicketConfig's category/role/message as a default.
model TicketType {
  id            String   @id @default(cuid())
  guildId       String
  label         String
  emoji         String?
  categoryId    String?
  supportRoleId String?
  openMessage   String?
  pingSupport   Boolean  @default(true)
  position      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([guildId])
}

model Ticket {
  id        String    @id @default(cuid())
  guildId   String
  channelId String
  userId    String
  number    Int
  typeId    String? // which TicketType this was opened as (null = default)
  claimedBy String? // staff user id that claimed it
  closedBy  String?
  status    String    @default("open") // open | closed
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([guildId, status])
}

// Stored conversation snapshot generated when a ticket is closed (channel is deleted after).
// Served as HTML to the dashboard and posted/DMed as a file.
model TicketTranscript {
  id        String   @id @default(cuid())
  guildId   String
  ticketId  String
  number    Int
  html      String
  closedBy  String?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([ticketId])
}

// ---- Giveaways ----
model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  prize       String
  winnerCount Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  entrants    String[] @default([])
  winners     String[] @default([])
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([ended, endsAt])
}

// ---- Starboard ----
model StarboardConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
  threshold Int     @default(3)
  emoji     String  @default("⭐")
}

model StarboardEntry {
  id               String @id @default(cuid())
  guildId          String
  sourceMessageId  String
  starboardMessageId String
  count            Int    @default(0)

  @@unique([guildId, sourceMessageId])
}

// ---- Suggestions ----
model SuggestionConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
}

model Suggestion {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String?
  authorId  String
  content   String
  status    String   @default("pending") // pending | approved | denied
  up        Int      @default(0)
  down      Int      @default(0)
  voters    String[] @default([])
  createdAt DateTime @default(now())

  @@index([guildId, status])
}

// ---- Reminders ----
model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  content   String
  remindAt  DateTime
  createdAt DateTime @default(now())

  @@index([remindAt])
  @@index([guildId, userId])
}

// ---- Birthdays ----
model BirthdayConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
  roleId    String?
}

model Birthday {
  guildId String
  userId  String
  day     Int
  month   Int

  @@id([guildId, userId])
  @@index([guildId, month, day])
}

// ---- AFK ----
model Afk {
  guildId String
  userId  String
  reason  String
  since   DateTime @default(now())

  @@id([guildId, userId])
}

// ---- Keyword highlights ----
model Highlight {
  id      String @id @default(cuid())
  guildId String
  userId  String
  word    String

  @@index([guildId])
  @@unique([guildId, userId, word])
}

// ---- Tags (custom snippets) ----
model Tag {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  content   String
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

// ---- Sticky messages ----
model StickyMessage {
  guildId       String
  channelId     String
  content       String
  lastMessageId String?
  enabled       Boolean @default(true)

  @@id([guildId, channelId])
}

// ---- Counting game ----
model CountingConfig {
  guildId    String  @id
  enabled    Boolean @default(false)
  channelId  String?
  current    Int     @default(0)
  best       Int     @default(0)
  lastUserId String?
}

// ---- Stat-counter channels ----
model StatCounter {
  id        String @id @default(cuid())
  guildId   String
  channelId String
  type      String // members | humans | bots | roles | channels | boosts
  template  String @default("{name}: {count}")

  @@index([guildId])
}

// ---- Member profiles (bio) ----
model Profile {
  guildId String
  userId  String
  bio     String?

  @@id([guildId, userId])
}

// ---- Report relay ----
model ReportConfig {
  guildId   String  @id
  channelId String?
}
