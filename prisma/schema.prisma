generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model GuildSettings {
  guildId        String         @id
  language       String         @default("ar")
  logChannelId   String?
  staffRoleIds   String[]       @default([])
  // Welcome / goodbye (1:1, folded in to avoid an extra join)
  welcomeEnabled Boolean        @default(false)
  welcomeChannelId String?
  welcomeMessage String?
  goodbyeEnabled Boolean        @default(false)
  goodbyeMessage String?
  autoRoleId     String?
  // Bot presence (dashboard-configurable). Null type = default Watching <count> عضو • /help.
  botPresenceType String?       // playing | listening | watching | streaming | custom
  botPresenceText String?
  botPresenceUrl  String?       // twitch/youtube URL, only for streaming
  // Rules acceptance gate (rules:accept button → grant rulesRoleId)
  rulesEnabled   Boolean        @default(false)
  rulesChannelId String?
  rulesMessage   String?
  rulesRoleId    String?
  rulesButtonLabel String?      // override default "أوافق على القوانين"
  // Premium welcome / goodbye (luxury embed + optional rendered card image)
  welcomeUseCard            Boolean @default(true)
  welcomeCardBg             String? // base64 data URL for a custom card background (cap ~1.5MB)
  welcomeCardStyle          String  @default("classic") // welcome card art style key (see WELCOME_CARD_STYLES)
  welcomeEmbedEnabled       Boolean @default(true) // false = plain text + bare card attachment (no embed box)
  goodbyeEmbedEnabled       Boolean @default(true) // false = plain goodbye text + bare card attachment
  welcomeButtons            Json    @default("[]") // [{ label, url, emoji? }]
  welcomeDmEnabled          Boolean @default(false)
  welcomeDmMessage          String?
  welcomeMentionDeleteSeconds Int   @default(0) // 0 = leave the ping, otherwise delete after N seconds
  goodbyeUseCard            Boolean @default(false)
  // Account-age / alt gate on join (0 = disabled). Action: kick | quarantine | alert
  minAccountAgeDays Int        @default(0)
  altGateAction  String         @default("alert")
  quarantineRoleId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  autoMod        AutoModConfig?
}

model AutoModConfig {
  guildId           String        @id
  enabled           Boolean       @default(false)
  antiSpam          Boolean       @default(false)
  antiInvite        Boolean       @default(false)
  antiLink          Boolean       @default(false)
  bannedWords       String[]      @default([])
  maxMentions       Int           @default(5)
  actionOnViolation String        @default("delete") // delete | warn | mute | kick | ban
  muteSeconds       Int           @default(300)
  ignoredChannelIds String[]      @default([])
  ignoredRoleIds    String[]      @default([])
  // Scam / phishing link defense — independent of the all-or-nothing antiLink switch.
  antiScam          Boolean       @default(false)
  scamDomains       String[]      @default([])
  scamAction        String        @default("delete") // delete | warn | mute | kick | ban
  settings          GuildSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
}

model ModerationCase {
  id           String    @id @default(cuid())
  guildId      String
  targetUserId String
  moderatorId  String
  type         String
  reason       String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  active       Boolean   @default(true)

  @@index([guildId, targetUserId])
  @@index([guildId, active, expiresAt])
  @@index([guildId, createdAt])
}

model LogEntry {
  id        String   @id @default(cuid())
  guildId   String
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([guildId, type, createdAt])
  @@index([guildId, createdAt])
}

// One row per guild per UTC day, upserted by the in-memory stat aggregator that
// the scheduler flushes. Powers the analytics charts without writing a row per event.
model DailyStat {
  id          String   @id @default(cuid())
  guildId     String
  date        String // YYYY-MM-DD (UTC)
  messages    Int      @default(0)
  joins       Int      @default(0)
  leaves      Int      @default(0)
  modActions  Int      @default(0)
  memberCount Int      @default(0)

  @@unique([guildId, date])
  @@index([guildId, date])
}

// ---- Leveling / XP ----
model LevelConfig {
  guildId         String  @id
  enabled         Boolean @default(false)
  xpPerMessage    Int     @default(18)
  cooldownSeconds Int     @default(60)
  multiplier      Int     @default(1)
  levelUpEnabled  Boolean @default(true)
  levelUpChannelId String?
  levelUpMessage  String? // {user} {level}
  stackRewards    Boolean @default(false)
  // Voice activity XP — credited per active minute in voice by the scheduler sweep.
  voiceXpEnabled         Boolean  @default(false)
  voiceXpPerMinute       Int      @default(5)
  ignoredVoiceChannelIds String[] @default([])
}

model LevelRoleReward {
  id      String @id @default(cuid())
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
  @@index([guildId])
}

model MemberLevel {
  guildId       String
  userId        String
  xp            Int      @default(0)
  level         Int      @default(0)
  lastMessageAt DateTime @default(now())

  @@id([guildId, userId])
  @@index([guildId, xp])
}

// ---- Button role panels ----
model RolePanel {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String?
  messageId   String?
  title       String
  description String?
  roles       Json     @default("[]") // [{ roleId, label, emoji?, style? }]
  createdAt   DateTime @default(now())

  @@index([guildId])
}

// ---- Auto-responder ----
model AutoResponse {
  id        String  @id @default(cuid())
  guildId   String
  trigger   String
  matchType String  @default("contains") // contains | exact | startswith
  reply     String
  enabled   Boolean @default(true)

  @@index([guildId])
}

// ---- Scheduled messages ----
model ScheduledMessage {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  content   String
  runAt     DateTime
  repeat    String   @default("none") // none | daily | weekly
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([enabled, runAt])
}

// ---- Tickets ----
model TicketConfig {
  guildId             String  @id
  enabled             Boolean @default(false)
  categoryId          String? // fallback "default type" when no TicketType rows exist
  supportRoleId       String?
  openMessage         String?
  counter             Int     @default(0)
  transcriptChannelId String? // where transcripts are posted; falls back to logChannelId
  dmOnOpen            Boolean @default(true)
  dmOnClose           Boolean @default(true)
}

// One configurable kind of ticket (Support / Report / Partnership...). When none exist the
// panel shows a single button and opens use TicketConfig's category/role/message as a default.
model TicketType {
  id            String   @id @default(cuid())
  guildId       String
  label         String
  emoji         String?
  categoryId    String?
  supportRoleId String?
  openMessage   String?
  pingSupport   Boolean  @default(true)
  position      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([guildId])
}

model Ticket {
  id        String    @id @default(cuid())
  guildId   String
  channelId String
  userId    String
  number    Int
  typeId    String? // which TicketType this was opened as (null = default)
  claimedBy String? // staff user id that claimed it
  closedBy  String?
  status    String    @default("open") // open | closed
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([guildId, status])
}

// Stored conversation snapshot generated when a ticket is closed (channel is deleted after).
// Served as HTML to the dashboard and posted/DMed as a file.
model TicketTranscript {
  id        String   @id @default(cuid())
  guildId   String
  ticketId  String
  number    Int
  html      String
  aiSummary String?  // optional Claude-generated Arabic summary, filled async on close
  closedBy  String?
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([ticketId])
}

// ---- Giveaways ----
model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  prize       String
  winnerCount Int      @default(1)
  endsAt      DateTime
  ended       Boolean  @default(false)
  entrants    String[] @default([])
  winners     String[] @default([])
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([ended, endsAt])
}

// ---- Starboard ----
model StarboardConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
  threshold Int     @default(3)
  emoji     String  @default("⭐")
}

model StarboardEntry {
  id               String @id @default(cuid())
  guildId          String
  sourceMessageId  String
  starboardMessageId String
  count            Int    @default(0)

  @@unique([guildId, sourceMessageId])
}

// ---- Suggestions ----
model SuggestionConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
}

model Suggestion {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String?
  authorId  String
  content   String
  status    String   @default("pending") // pending | approved | denied
  up        Int      @default(0)
  down      Int      @default(0)
  voters    String[] @default([])
  createdAt DateTime @default(now())

  @@index([guildId, status])
}

// ---- Reminders ----
model Reminder {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  content   String
  remindAt  DateTime
  createdAt DateTime @default(now())

  @@index([remindAt])
  @@index([guildId, userId])
}

// ---- Birthdays ----
model BirthdayConfig {
  guildId   String  @id
  enabled   Boolean @default(false)
  channelId String?
  roleId    String?
}

model Birthday {
  guildId String
  userId  String
  day     Int
  month   Int

  @@id([guildId, userId])
  @@index([guildId, month, day])
}

// ---- AFK ----
model Afk {
  guildId String
  userId  String
  reason  String
  since   DateTime @default(now())

  @@id([guildId, userId])
}

// ---- Keyword highlights ----
model Highlight {
  id      String @id @default(cuid())
  guildId String
  userId  String
  word    String

  @@index([guildId])
  @@unique([guildId, userId, word])
}

// ---- Tags (custom snippets) ----
model Tag {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  content   String
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([guildId, name])
  @@index([guildId])
}

// ---- Sticky messages ----
model StickyMessage {
  guildId       String
  channelId     String
  content       String
  lastMessageId String?
  enabled       Boolean @default(true)

  @@id([guildId, channelId])
}

// ---- Counting game ----
model CountingConfig {
  guildId    String  @id
  enabled    Boolean @default(false)
  channelId  String?
  current    Int     @default(0)
  best       Int     @default(0)
  lastUserId String?
}

// ---- Stat-counter channels ----
model StatCounter {
  id        String @id @default(cuid())
  guildId   String
  channelId String
  type      String // members | humans | bots | roles | channels | boosts
  template  String @default("{name}: {count}")

  @@index([guildId])
}

// ---- Member profiles (bio + timezone) ----
model Profile {
  guildId  String
  userId   String
  bio      String?
  timezone String? // IANA tz id (e.g. "Asia/Riyadh"); used by /time to display local time

  @@id([guildId, userId])
}

// Staff-only private notes about a member, separate from ModerationCase (not enforced — just a watchlist/memo).
model MemberNote {
  id        String   @id @default(cuid())
  guildId   String
  userId    String // the member the note is about
  authorId  String // the staff member who wrote it
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@index([guildId, createdAt])
}

// ---- Report relay ----
model ReportConfig {
  guildId   String  @id
  channelId String?
}

// ---- Temporary voice rooms (Join-to-Create) ----
model TempVoiceConfig {
  guildId          String  @id
  enabled          Boolean @default(false)
  hubChannelId     String? // the "Join to Create" voice channel
  categoryId       String? // category to create temp channels under (optional)
  nameTemplate     String  @default("روم {user}") // {user} = display name
  defaultUserLimit Int     @default(0) // 0 = unlimited
  defaultLocked    Boolean @default(false)
}

model TempVoiceChannel {
  channelId String   @id
  guildId   String
  ownerId   String
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([ownerId])
}

// ---- Creator content announcements (auto-ping when a new YouTube/TikTok video drops) ----
model CreatorAnnounceConfig {
  guildId         String  @id
  enabled         Boolean @default(false)
  channelId       String? // where announcements are posted
  pingMode        String  @default("everyone") // everyone | here | role | none
  pingRoleId      String? // used when pingMode == "role"
  messageTemplate String? // {title} {url} {platform} {creator}; null => built-in Arabic default
  // YouTube — detected free via the channel's Atom RSS feed (no API key)
  youtubeEnabled     Boolean   @default(false)
  youtubeChannelId   String? // resolved UC… id
  youtubeLastVideoId String? // last announced video id (null => baseline, announce nothing)
  lastPolledYt       DateTime?
  // TikTok — best-effort via a RapidAPI scraper (key in env, not DB)
  tiktokEnabled     Boolean   @default(false)
  tiktokUsername    String? // without leading @
  tiktokLastVideoId String?
  lastPolledTt      DateTime?
}

// ---- Invite tracking (who invited whom + per-inviter leaderboard) ----
model InviteConfig {
  guildId         String  @id
  enabled         Boolean @default(false)
  fakeDays        Int     @default(7) // joiners whose account is younger than N days count as "fake"
  rewardRoleId    String? // role granted once an inviter passes rewardThreshold regular invites
  rewardThreshold Int     @default(0) // 0 = no reward role
  logChannelId    String? // where join attributions are posted (falls back to logChannelId)
}

model InviteRecord {
  id        String   @id @default(cuid())
  guildId   String
  inviterId String // who owned the used invite ("" = unknown / vanity)
  joinerId  String
  code      String?
  fake      Boolean  @default(false)
  left      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([guildId, inviterId])
  @@index([guildId, joinerId])
}

model InviteStat {
  guildId String
  userId  String // the inviter
  regular Int    @default(0)
  fake    Int    @default(0)
  left    Int    @default(0)

  @@id([guildId, userId])
  @@index([guildId, regular])
}

// ---- Anti-raid join-gate + auto-lockdown ----
model RaidConfig {
  guildId           String  @id
  enabled           Boolean @default(false)
  joinWindowSec     Int     @default(10) // sliding window
  joinThreshold     Int     @default(8) // joins within the window that trip the gate
  action            String  @default("lockdown") // lockdown | kick | ban
  raiseVerification Boolean @default(true) // bump guild verification to highest while locked
  alertChannelId    String? // falls back to logChannelId
  autoLiftMinutes   Int     @default(10) // auto-release lockdown after N minutes (0 = manual only)
}

// ---- Reusable embed builder / library ----
model SavedEmbed {
  id              String   @id @default(cuid())
  guildId         String
  name            String
  payload         Json     @default("{}") // { title, description, color, fields[], image, thumbnail, footer, author, buttons[] }
  postedChannelId String?
  postedMessageId String? // set after first post; enables in-place edit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([guildId, name])
  @@index([guildId])
}

// ---- Server economy / currency ----
model EconomyConfig {
  guildId         String  @id
  enabled         Boolean @default(false)
  currencyName    String  @default("عملة")
  currencyEmoji   String  @default("🪙")
  perMessage      Int     @default(5)
  cooldownSeconds Int     @default(60)
  dailyAmount     Int     @default(200)
  streakBonus     Int     @default(50) // extra per consecutive daily, capped by maxStreakBonus
  maxStreakBonus  Int     @default(500)
}

model Wallet {
  guildId   String
  userId    String
  balance   Int       @default(0)
  lastDaily DateTime?
  streak    Int       @default(0)

  @@id([guildId, userId])
  @@index([guildId, balance])
}

model EconomyTransaction {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int // signed
  reason    String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
}

// ---- Application / form builder ----
model ApplicationForm {
  id              String                @id @default(cuid())
  guildId         String
  name            String
  description     String?
  reviewChannelId String? // where submissions land with accept/deny buttons
  acceptRoleId    String? // granted on accept
  enabled         Boolean               @default(true)
  createdAt       DateTime              @default(now())
  questions       ApplicationQuestion[]

  @@index([guildId])
}

model ApplicationQuestion {
  id       String          @id @default(cuid())
  formId   String
  label    String
  style    String          @default("short") // short | paragraph
  required Boolean         @default(true)
  position Int             @default(0)
  form     ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model ApplicationSubmission {
  id         String   @id @default(cuid())
  guildId    String
  formId     String
  userId     String
  answers    Json     @default("[]") // [{ label, answer }]
  status     String   @default("pending") // pending | accepted | denied
  reviewedBy String?
  messageId  String?
  createdAt  DateTime @default(now())

  @@index([guildId, status])
  @@index([formId])
}

// ---- Weekly digest auto-post ----
model DigestConfig {
  guildId     String  @id
  enabled     Boolean @default(false)
  channelId   String?
  weekday     Int     @default(1) // 0=Sun .. 6=Sat (UTC)
  lastSentKey String? // ISO week key already posted (dedupe across restarts)
}

// ---- Role shop (spend economy currency on roles) ----
model ShopItem {
  id            String   @id @default(cuid())
  guildId       String
  roleId        String
  label         String?
  price         Int
  stock         Int      @default(-1) // -1 = unlimited
  durationHours Int? // null = permanent; otherwise a temp role that expires
  requiredLevel Int? // gate purchase behind a level
  position      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([guildId])
}

model ShopPurchase {
  id        String    @id @default(cuid())
  guildId   String
  userId    String
  itemId    String
  roleId    String
  expiresAt DateTime? // for temp roles; null = permanent
  createdAt DateTime  @default(now())

  @@index([guildId, userId])
  @@index([expiresAt])
}

// ---- Booster tracking + auto perks ----
model BoosterConfig {
  guildId           String   @id
  enabled           Boolean  @default(false)
  announceChannelId String?
  message           String? // {user} {server} {count}
  perkRoleIds       String[] @default([])
  coinBonus         Int      @default(0) // economy reward granted on boost start
}

model BoosterRecord {
  guildId   String
  userId    String
  startedAt DateTime @default(now())
  active    Boolean  @default(true)

  @@id([guildId, userId])
  @@index([guildId, active])
}

// ---- Member churn & activity alerts (aggregate-trend, distinct from per-message automod) ----
model AlertConfig {
  guildId             String  @id
  enabled             Boolean @default(false)
  alertChannelId      String? // falls back to logChannelId
  leaveSpikeEnabled   Boolean @default(true)
  leaveSpikeThreshold Int     @default(10) // leaves within a single UTC day
  activityDropEnabled Boolean @default(true)
  activityDropPct     Int     @default(50) // alert when today's messages fall N% below the 7-day average
  joinSpikeEnabled    Boolean @default(true)
  joinSpikeThreshold  Int     @default(20)
  lastAlertKey        String? // dedupe: "<rule>:<YYYY-MM-DD>"
}
